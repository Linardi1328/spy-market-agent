ENVIRONMENT=development
EXECUTION_MODE=paper
ENABLE_PAPER_EXECUTION=false
DRY_RUN=true
INITIAL_CAPITAL_USD=10000
DATABASE_URL=sqlite:///./spy_market_agent.db
SQLITE_DATABASE_PATH=./spy_market_agent.sqlite3
DASHBOARD_API_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT_SECONDS=5
MARKET_SYMBOL=SPY
MARKET_TIMEFRAME=1Day
EXCHANGE_CALENDAR=XNYS
MARKET_TIMEZONE=America/New_York
ADJUSTMENT_POLICY=adjusted

# Future Alpaca paper credentials only. Alpaca integration is not implemented in Phase 7.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
