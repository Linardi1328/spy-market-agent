ENVIRONMENT=development
EXECUTION_MODE=paper
ENABLE_PAPER_EXECUTION=false
DRY_RUN=true
PAPER_EXECUTION_KILL_SWITCH=true
# Version 1 requires regular market hours for any explicit paper execution path.
PAPER_EXECUTION_REQUIRE_MARKET_OPEN=true
INITIAL_CAPITAL_USD=10000
DATABASE_URL=sqlite:///./spy_market_agent.db
SQLITE_DATABASE_PATH=./spy_market_agent.sqlite3
DASHBOARD_API_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT_SECONDS=5
MARKET_SYMBOL=SPY
MARKET_TIMEFRAME=1Day
EXCHANGE_CALENDAR=XNYS
MARKET_TIMEZONE=America/New_York
ADJUSTMENT_POLICY=adjusted

# Optional Alpaca paper credentials. Keep placeholders only in committed files.
# The committed defaults cannot submit an order.
# Both PAPER_EXECUTION_KILL_SWITCH and the durable SQLite kill switch must be
# deliberately disengaged before an explicitly invoked paper submission can proceed.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=

# Historical market-data credentials used only by explicit acquisition.
# These are deliberately separate from paper-trading credentials and are never
# accepted as command-line arguments.
# ALPACA_MARKET_DATA_API_KEY=
# ALPACA_MARKET_DATA_SECRET_KEY=
ALPACA_MARKET_DATA_FEED=sip
MARKET_DATA_ROOT=./data
MARKET_DATA_MAX_RETRIES=3
MARKET_DATA_TIMEOUT_SECONDS=30
